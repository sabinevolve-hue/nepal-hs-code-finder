{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/search", "destination": "/index.html" },
    { "source": "/ask-ai", "destination": "/index.html" },
    { "source": "/trade-data", "destination": "/index.html" },
    { "source": "/browse", "destination": "/index.html" },
    { "source": "/calculator", "destination": "/index.html" },
    { "source": "/invoice", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/saved", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
